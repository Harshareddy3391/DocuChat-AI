# ==========================================
# DocuChat AI Configuration Template
# ==========================================

# ------------------------------------------
# FastAPI Backend Configuration
# ------------------------------------------
APP_NAME="DocuChat AI"
APP_VERSION="1.0.0"
DEBUG=True

# Database connection URLs (Supabase / local PostgreSQL)
# DATABASE_URL: Pooler or main connection with vector support
# DIRECT_URL: Direct session connection for database migrations
DATABASE_URL="postgresql+psycopg2://<username>:<password>@<host>:<port>/<db_name>"
DIRECT_URL="postgresql+psycopg2://<username>:<password>@<host>:<port>/<db_name>"

# Google OAuth API Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

# JSON Web Tokens (JWT) Settings
JWT_SECRET_KEY="generate-a-long-random-secure-string"
JWT_ALGORITHM="HS256"
ACCESS_TOCKEN_EXPIRE_MINUTES=60

# Supabase Storage Configuration
SUPABASE_URL="https://<your-supabase-project>.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-role-key"
SUPABASE_BUCKET="documents"

# OpenAI API Configuration
OPENAI_API_KEY="sk-proj-yourOpenAIKey..."

# ------------------------------------------
# React + Vite Frontend Configuration
# ------------------------------------------
FRONTEND_URL="http://localhost:3000"
# Vite environment variable for the base API path
VITE_API_URL="http://localhost:8000"
